# Backend environment variables (copy to .env and fill in real values)
# Never commit the real .env file.

# Flask
FLASK_DEBUG=1

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Flask session secret (keep secret)
SECRET_KEY=change-me-to-a-long-random-string

# JWT authentication (keep secret; never expose to the frontend)
JWT_SECRET_KEY=replace-with-a-strong-secret
# Access token lifetime in hours (defaults to 12)
JWT_ACCESS_TOKEN_HOURS=12

# Database
# PostgreSQL (production): postgresql+psycopg://username:password@host:5432/dbname
# If DATABASE_URL is not set, the app falls back to a local SQLite file for development.
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/great_alexender_enterprise

# SMS provider (used in later phases; keep secret)
SMS_PROVIDER=hubtel
SMS_API_KEY=
SMS_CLIENT_ID=
SMS_CLIENT_SECRET=
SMS_SENDER_ID=
