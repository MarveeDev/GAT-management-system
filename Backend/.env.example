# Backend environment variables (copy to .env and fill in real values)
# Never commit the real .env file.

# Environment: development | testing | production
# - development (default): uses development-only fallbacks and may enable debug.
# - production: requires SECRET_KEY, JWT_SECRET_KEY and DATABASE_URL; fails fast otherwise.
#   Use FLASK_ENV=production (or APP_ENV=production) only when deploying.
FLASK_ENV=development

# Debug mode. Safe default is off. Set to 1 only for local development.
FLASK_DEBUG=0

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Flask session secret (keep secret; required in production)
SECRET_KEY=change-me-to-a-long-random-string

# JWT authentication (keep secret; required in production; never expose to the frontend)
JWT_SECRET_KEY=replace-with-a-strong-secret
# Access token lifetime in hours (defaults to 12)
JWT_ACCESS_TOKEN_HOURS=12

# Database
# Production requires DATABASE_URL (PostgreSQL), e.g.:
#   postgresql+psycopg://username:password@host:5432/database
# In development, if DATABASE_URL is not set, the app falls back to a local SQLite file.
DATABASE_URL=

# SMS provider (default: mock; never sends real SMS)
# Options:
#   mock    - development/testing provider (no real SMS is sent)
#   gonline - real GONLINE SMS API (server-side only; API key stays in the backend)
SMS_PROVIDER=mock
# GONLINE API key (required when SMS_PROVIDER=gonline; keep secret)
SMS_API_KEY=
# Approved GONLINE Sender ID (e.g. GAT); required when SMS_PROVIDER=gonline
SMS_SENDER_ID=
# Set to 1 to make the mock provider simulate failures (development/testing only)
SMS_MOCK_FAIL=0

# Login rate limiting (in-process). Failed login attempts per (ip, email)
# before throttling; total failed attempts per ip; and the window in seconds.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=25
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
