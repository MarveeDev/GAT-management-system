# Backend environment variables (copy to .env and fill in real values)
# Never commit the real .env file.

# Flask
FLASK_DEBUG=1

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Auth (used in later phases; keep secret)
JWT_SECRET=change-me-to-a-long-random-string

# Database (used in later phases)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/great_alexender

# SMS provider (used in later phases; keep secret)
SMS_PROVIDER=hubtel
SMS_API_KEY=
SMS_CLIENT_ID=
SMS_CLIENT_SECRET=
SMS_SENDER_ID=
