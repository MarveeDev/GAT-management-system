# Frontend environment variables (copy to .env for local overrides)
# Only safe-to-expose values belong here. Secrets stay on the backend.

# Base URL of the Flask API. Leave empty in local dev to use the Vite proxy.
# In production (e.g. Vercel), set this to the deployed backend URL, e.g.
# VITE_API_URL=https://your-backend.up.railway.app
VITE_API_URL=
