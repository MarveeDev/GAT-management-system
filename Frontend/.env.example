# Frontend environment variables (copy to .env for local overrides)
# Only safe-to-expose values belong here. Secrets stay on the backend.

# Base URL/path for the Flask API.
# Local dev: use the Vite proxy by setting this to /api (default).
# Production (e.g. Vercel -> Railway): set to the deployed backend URL, e.g.
# VITE_API_BASE_URL=https://your-backend.up.railway.app/api
VITE_API_BASE_URL=/api
